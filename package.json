    "repository": {
        "type": "git",
        "url": "https://github.com/8Crafter-Studios/Bedrock-World-Editor.git"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.18.0",
