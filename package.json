{
    "name": "bedrock-world-editor",
    "productName": "Bedrock World Editor",
    "version": "1.0.0-beta.35",
    "build": "BUILD.1",
    "description": "An NBT editor for Minecraft Bedrock Edition.",
    "main": ".vite/build/main.js",
    "type": "commonjs",
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "lint": "eslint --ext .ts,.tsx .",
        "install": "cd node_modules/@8crafter/leveldb-zlib && npm run install",
        "version": "node scripts/resetPackageBuildNumber.mts",
        "resetBuild": "node scripts/resetPackageBuildNumber.mts",
        "bumpBuild": "node scripts/bumpPackageBuildNumber.mts"
    },
    "keywords": [],
    "author": {
